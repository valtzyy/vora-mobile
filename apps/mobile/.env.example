# Copy this file to .env.local and adjust for your environment.
# On a physical device/emulator, `localhost` does not resolve to your dev
# machine — use your computer's LAN IP instead.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000

# Deployed web app — used for share links to a scan's public result page.
EXPO_PUBLIC_WEB_FRONTEND_URL=https://vora-frontend-six.vercel.app
