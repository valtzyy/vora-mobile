{
  "name": "vora-mobile-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "mobile": "pnpm --filter @vora/mobile start",
    "mobile:android": "pnpm --filter @vora/mobile android",
    "mobile:ios": "pnpm --filter @vora/mobile ios",
    "build:packages": "pnpm --filter './packages/*' build",
    "type-check": "pnpm --filter './packages/*' type-check && pnpm --filter @vora/mobile type-check",
    "lint": "pnpm --filter './packages/*' lint && pnpm --filter @vora/mobile lint"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
